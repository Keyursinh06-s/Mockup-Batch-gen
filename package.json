    "@babel/preset-env": "^7.22.0",
    "@babel/plugin-proposal-class-properties": "^7.18.0",
    "babel-loader": "^9.1.0",
    "eslint": "^8.45.0",
    "jest": "^29.0.0",
    "nodemon": "^2.0.0",
    "rimraf": "^5.0.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.1.0",
    "webpack-bundle-analyzer": "^4.9.0"
  },
